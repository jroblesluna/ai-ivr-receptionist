# =============================================================================
# PickUp AI IVR Receptionist - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For local development, only the secret keys below are required.
# AWS-specific variables are only needed for deployed environments.
# =============================================================================

# --- Application ---
ENVIRONMENT=dev
SECRET_KEY=***

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickup

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AWS Configuration (only required in deployed environments) ---
# When AWS_REGION is not set, the app falls back to env vars for secrets.
AWS_REGION=
AWS_SECRET_NAME=pickup/dev/secrets

# --- S3 Storage (only required in deployed environments) ---
S3_REPORTS_BUCKET=pickup-dev-reports
S3_AUDIO_BUCKET=pickup-dev-audio

# --- Gunicorn ---
GUNICORN_WORKERS=1

# --- Twilio ---
TWILIO_ACCOUNT_SID=AC***
TWILIO_AUTH_TOKEN=***
TWILIO_API_KEY_SID=SK***
TWILIO_API_KEY_SECRET=***
TWILIO_TWIML_APP_SID=AP***
TWILIO_VERIFY_SID=VA***

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-***

# --- ElevenLabs ---
ELEVENLABS_API_KEY=sk_***

# --- Google TTS ---
GOOGLE_TTS_API_KEY=AIza***

# --- Resend (Email) ---
RESEND_API_KEY=re_***
RESEND_FROM="AI Receptionist <noreply@***>"

# --- Admin ---
ADMIN_PASSWORD=***
